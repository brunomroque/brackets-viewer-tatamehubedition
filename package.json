{
    "name": "@tatamearena/brackets-viewer",
    "version": "1.10.0",
    "description": "TatameArena fork of brackets-viewer.js — two-sided layout and A4 print pagination for tournament brackets",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/",
        "NOTICE",
        "LICENSE"
    ],
    "scripts": {
        "db": "npx json-server --watch demo/db.json",
        "build": "npx webpack --mode production && npm run tsc",
        "start": "npx webpack --watch --mode development",
        "prepare": "npm run build",
        "prepublishOnly": "npm run build",
        "lint": "eslint '**/*.{js,ts}' --fix",
        "test": "npx tsc -p tsconfig.test.json && node --test dist-test/print/*.test.js dist-test/twoSided.test.js",
        "watch-demo": "browser-sync demo . --watch dist",
        "tsc": "tsc --emitDeclarationOnly"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/brunomroque/brackets-viewer-tatamehubedition.git"
    },
    "keywords": [
        "javascript",
        "tournament",
        "brackets",
        "viewer",
        "display",
        "two-sided",
        "print",
        "tatamearena"
    ],
    "author": "Corentin Girard",
    "contributors": [
        "TatameArena"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/brunomroque/brackets-viewer-tatamehubedition/issues"
    },
    "browserslist": [
        "defaults",
        "not IE 11"
    ],
    "homepage": "https://github.com/brunomroque/brackets-viewer-tatamehubedition#readme",
    "dependencies": {
        "brackets-manager": "^1.11.0",
        "brackets-memory-db": "^1.0.6",
        "brackets-model": "^1.7.0",
        "i18next": "^21.6.14",
        "i18next-browser-languagedetector": "^6.1.4",
        "path-browserify": "^1.0.1",
        "process": "^0.11.10",
        "util": "^0.12.4"
    },
    "devDependencies": {
        "@babel/core": "^7.17.8",
        "@types/node": "18.11.9",
        "@typescript-eslint/eslint-plugin": "^5.16.0",
        "@typescript-eslint/parser": "^5.16.0",
        "autoprefixer": "^10.4.4",
        "babel-loader": "^8.2.4",
        "browser-sync": "^2.29.3",
        "css-loader": "^6.7.1",
        "eslint": "^8.12.0",
        "eslint-plugin-jsdoc": "^38.0.8",
        "json-server": "^0.17.3",
        "mini-css-extract-plugin": "^2.6.0",
        "postcss": "^8.4.12",
        "postcss-loader": "^6.2.1",
        "sass": "^1.49.9",
        "sass-loader": "^12.6.0",
        "ts-loader": "^9.2.8",
        "typedoc": "0.25.0",
        "typescript": "^4.6.3",
        "webpack": "^5.70.0",
        "webpack-cli": "^4.10.0"
    },
    "volta": {
        "node": "20.18.0",
        "npm": "10.8.2"
    }
}
